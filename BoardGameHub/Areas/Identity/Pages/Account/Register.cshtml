@page
@using BoardGameHub.Common
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <h1 class="h3 fw-bold mb-1">Join BoardGameHub</h1>
                        <p class="text-muted small">Create your account to explore, play, or manage your store.</p>
                    </div>

                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label fw-semibold small text-uppercase mb-1">Email address</label>
                            <input asp-for="Input.Email" type="email" class="form-control form-control-lg" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label fw-semibold small text-uppercase mb-1">Password</label>
                            <input asp-for="Input.Password" type="password" class="form-control form-control-lg" autocomplete="new-password" aria-required="true" placeholder="Enter your password" />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold small text-uppercase mb-1">Confirm Password</label>
                            <input asp-for="Input.ConfirmPassword" type="password" class="form-control form-control-lg" autocomplete="new-password" aria-required="true" placeholder="Repeat your password" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold small text-uppercase mb-2">Account Type</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <input type="radio" class="btn-check" asp-for="Input.Role" id="roleUser" value="@RoleNames.User" checked />
                                    <label class="btn btn-outline-primary w-100 h-100 py-3 d-flex flex-column align-items-center justify-content-center rounded-3" for="roleUser">
                                        <span class="fw-bold">Player</span>
                                        <span class="small opacity-75 mt-1" style="font-size: 0.75rem;">Browse &amp; review games</span>
                                    </label>
                                </div>
                                <div class="col-6">
                                    <input type="radio" class="btn-check" asp-for="Input.Role" id="roleShop" value="@RoleNames.Shop" />
                                    <label class="btn btn-outline-primary w-100 h-100 py-3 d-flex flex-column align-items-center justify-content-center rounded-3" for="roleShop">
                                        <span class="fw-bold">Store Owner</span>
                                        <span class="small opacity-75 mt-1" style="font-size: 0.75rem;">List &amp; manage inventory</span>
                                    </label>
                                </div>
                            </div>
                            <span asp-validation-for="Input.Role" class="text-danger small d-block mt-1"></span>
                        </div>

                        <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary rounded-3 fw-semibold">
                            Create Account
                        </button>

                        <div class="text-center mt-4">
                            <span class="text-muted small">Already have an account?</span>
                            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="small fw-semibold text-decoration-none ms-1">Sign in</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}