@using System.Globalization
@model IEnumerable<BoardGameHub.ViewModel.TournamentModels.TournamentIndex>

<section class="mt-4 tournaments-dark-section">
    <div class="d-flex justify-content-between align-items-center mb-3 tournaments-header">
        <h4 class="mb-0 tournaments-title">
            <span class="tournaments-title-accent"></span>Tournaments
        </h4>

        @if (Model != null && Model.Any())
        {
            <span class="badge rounded-pill badge-count-red">
                @Model.Count()
            </span>
        }
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info mb-0">
            There are no tournaments scheduled for this store yet.
        </div>
    }
    else
    {
        <div class="card card-dark-red">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Title</th>
                            <th scope="col">Starts</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-end">Game</th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var tournament in Model)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @tournament.Title
                                </td>

                                <td>
                                    @tournament.StartDateAndTime.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)
                                </td>

                                <td>
                                    @if (tournament.Status)
                                    {
                                        <span class="status-pill status-active">
                                            <span class="status-dot"></span>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-closed">
                                            <span class="status-dot"></span>
                                            Closed
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <a asp-controller="Game"
                                       asp-action="Details"
                                       asp-route-id="@tournament.GameId"
                                       class="btn btn-sm btn-outline-primary">
                                        View game &rarr;
                                    </a>
                                </td>

                                <td class="text-end">
                                    @if (tournament.Status)
                                    {
                                        <form asp-controller="Tournament"
                                              asp-action="Join"
                                              asp-route-id="@tournament.Id"
                                              method="post"
                                              class="d-inline">

                                            <button type="submit"
                                                    class="btn btn-sm btn-join-tournament">
                                                Join Tournament
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                disabled>
                                            Registration Closed
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>
