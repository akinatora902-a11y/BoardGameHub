@{
    ViewData["Title"] = "500 - Internal Server Error";
    Layout = null;
}

<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/error.css" asp-append-version="true" />
</head>
<body>
    <main class="fullscreen-500">
        <div class="content-box">
            <h1>500</h1>
            <h2>Something got tangled up in the machine</h2>
            <p>
                An unexpected server error has occurred. Please try again in a few moments or go back to the beginning.
            </p>
            <a asp-controller="Home" asp-action="Index" class="btn-home">Back to the beginning</a>
        </div>
    </main>
</body>
</html>