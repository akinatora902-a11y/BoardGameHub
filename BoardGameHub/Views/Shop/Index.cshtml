@model IEnumerable<BoardGameHub.ViewModel.ShopModels.ShopIndex>

@{
    ViewData["Title"] = "Stores";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">@ViewData["Title"]</h1>
    <a asp-action="Create" class="btn btn-primary">Add a store</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No stores have been added yet.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var shop in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@shop.Name</h5>
                        <a asp-action="Details" asp-route-id="@shop.Id"
                           class="btn btn-outline-primary mt-auto">
                            More information
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}