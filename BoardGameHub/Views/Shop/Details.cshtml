@model BoardGameHub.ViewModel.ShopModels.ShopDetail

@{
    ViewData["Title"] = "Детайли";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="card-title mb-0">Описание</h4>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            Назад
                        </a>
                    </div>

                    <hr />

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="card-text fs-5 mb-0">@Model.Description</p>
                    }
                    else
                    {
                        <p class="text-muted fst-italic mb-0">Няма добавено описание.</p>
                    }
                </div>
            </div>

            <partial name="TournamentIndexPartial" model="Model.Tournaments" />
        </div>
    </div>
</div>