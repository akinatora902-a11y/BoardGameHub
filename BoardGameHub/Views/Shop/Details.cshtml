@model BoardGameHub.ViewModel.ShopModels.ShopDetail

@{
    ViewData["Title"] = "Details";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center py-3 px-4">
                    <div class="d-flex align-items-center">
                        <span class="tournaments-title-accent"></span>
                        <h4 class="card-title mb-0 text-uppercase" style="font-size: 1.05rem; letter-spacing: 0.6px;">
                            Description
                        </h4>
                    </div>

                    <a asp-action="Index" class="btn btn-outline-primary btn-sm px-3">
                        &larr; Back
                    </a>
                </div>

                <div class="card-body p-4">
                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="card-text fs-5 mb-0" style="line-height: 1.7;">
                            @Model.Description
                        </p>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            Няма добавено описание.
                        </div>
                    }
                </div>
            </div>

            <partial name="TournamentIndexPartial" model="Model.Tournaments" />
        </div>
    </div>
</div>